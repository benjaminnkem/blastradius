{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "BLASTRADIUS_PROJECT",
    "APP_VERSION",
    "ARKIV_RPC_URL",
    "ARKIV_CHAIN_ID",
    "ARKIV_NETWORK_NAME",
    "ARKIV_EXPLORER_URL",
    "REDIS_URL",
    "API_HOST",
    "API_PORT",
    "MONITOR_HEALTH_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
