# ==============================================================================
# BlastRadius — Environment Configuration Template
# ==============================================================================
# All variables in this template use safe development defaults.
# NEVER commit real private keys or production credentials to source control.
# ==============================================================================

# Core Application Environment
NODE_ENV=development
LOG_LEVEL=info

# Service Ports
API_PORT=4000
MONITOR_PORT=4001
WEB_PORT=3000

# Redis Connection (BullMQ, Locks, Throttling — Reconstructable cache only)
REDIS_URL=redis://localhost:6379

# Arkiv EVM Network Configuration
ARKIV_RPC_URL=https://rpc.kaolin.arkiv.network
ARKIV_CHAIN_ID=1001
ARKIV_PROJECT_NAMESPACE=blastradius-v1

# Publisher Keys (Dedicated private keys per role — Keep secure in secret manager)
# MONITOR_PRIVATE_KEY=0x...
# CURATOR_PRIVATE_KEY=0x...
# PROTOCOL_PRIVATE_KEY=0x...

# Monitored Blockchain RPC Endpoints (Layer-2 Base)
BASE_RPC_PRIMARY=https://mainnet.base.org
BASE_RPC_SECONDARY=https://base.llamarpc.com
BASE_RPC_TERTIARY=https://1rpc.io/base
BASE_CHAIN_ID=8453

# Public Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
