# BlastRadius Phase 0 environment skeleton.
# Copy to service-specific files (apps/api/.env, apps/monitor/.env, apps/web/.env.local).
# Never put private keys, RPC tokens, or real endpoints with embedded auth in this file.

NODE_ENV=development
LOG_LEVEL=info
BLASTRADIUS_PROJECT=blastradius-v1
APP_VERSION=0.0.0-phase0

# Arkiv — required together when enabled. No default network.
# Do not use retired Braga values. Verify current docs before setting.
# ARKIV_RPC_URL=
# ARKIV_CHAIN_ID=
# ARKIV_NETWORK_NAME=
# ARKIV_EXPLORER_URL=

# Redis — required in later phases for BullMQ/cache. Optional in Phase 0.
# REDIS_URL=redis://127.0.0.1:6379

API_HOST=127.0.0.1
API_PORT=3001
MONITOR_HEALTH_PORT=3002

# Public web only. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_ARKIV_EXPLORER_URL=
